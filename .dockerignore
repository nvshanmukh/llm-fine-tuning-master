# Keep the build context small: the inference image only needs src/ + configs/.
.git/
.gitignore
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Data, experiments, tracking DB, model weights - never in the image
data/
experiments/
mlruns/
mlflow.db
*.safetensors
*.bin
*.gguf

# Dev-only
.env
notes/
notebooks/
*.ipynb
tests/
docs/
README.md
Dockerfile.train
