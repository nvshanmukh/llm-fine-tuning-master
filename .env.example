# Copy to .env and fill in. NEVER commit .env.

# --- HuggingFace ---
# Only needed for gated models / higher download rate limits. Qwen2.5-1.5B is public.
HF_TOKEN=

# --- Experiment tracking ---
# Recent MLflow rejects the legacy ./mlruns file store. Use a local SQLite DB
# (default) or point at a tracking server.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Inference API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=INFO

# Base model (HF id or local path) served by the API.
INFERENCE_MODEL_PATH=Qwen/Qwen2.5-1.5B
# Optional: pin the base model to a specific HF commit (see configs/base.yaml).
INFERENCE_MODEL_REVISION=
# Optional PEFT adapter directory (leave empty to serve the base model).
INFERENCE_ADAPTER_PATH=
# "true" to load the base model in 4-bit for inference (optional; needs CUDA + `pip install bitsandbytes`).
LOAD_IN_4BIT=false
# "true" to start the API without loading a model (readiness probes / tests only).
API_SKIP_MODEL_LOAD=false

# --- LLM-as-a-judge (optional; scripts/judge_eval.py) ---
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL=gpt-4o-mini
