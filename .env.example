# Copy this to .env and fill in values
# NEVER commit .env to version control

# HuggingFace access token (required for gated models)
HF_TOKEN=hf_your_token_here

# MLflow tracking server URI (default: local ./mlruns)
MLFLOW_TRACKING_URI=./mlruns

# Optional: Set to 0 for CPU-only inference
CUDA_VISIBLE_DEVICES=0

# Inference API config
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Model path for the inference server
INFERENCE_MODEL_PATH=./experiments/qlora
INFERENCE_ADAPTER_PATH=
INFERENCE_BASE_MODEL=Qwen/Qwen2.5-1.5B
