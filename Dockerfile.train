# =============================================================================
# Finance LLM Training Image - GPU (CUDA)
# =============================================================================
# For cloud GPU instances (Colab, Kaggle, Lambda, RunPod, ...).
# Includes the full training + evaluation stack plus a CUDA bitsandbytes build
# for QLoRA.
#
# Build:
#   docker build -f Dockerfile.train -t finance-llm-train .
#
# Run (requires --gpus all):
#   docker run --gpus all \
#     -v $(pwd)/data:/app/data \
#     -v $(pwd)/experiments:/app/experiments \
#     -e HF_TOKEN=hf_your_token \
#     finance-llm-train \
#     python scripts/train.py --config configs/qlora.yaml
# =============================================================================

FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# torch is already provided by the base image; install the rest + CUDA bitsandbytes.
RUN pip install --upgrade pip --no-cache-dir \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "bitsandbytes>=0.43"

COPY . .

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/app/.cache/huggingface

CMD ["python", "scripts/train.py", "--help"]
